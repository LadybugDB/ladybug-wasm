{
  "name": "@ladybugdb/wasm-core",
  "version": "0.15.1",
  "description": "Official WebAssembly build of Lbug in-process property graph database management system.",
  "main": "index.js",
  "types": "index.d.ts",
  "homepage": "https://ladybugdb.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LadybugDB/ladybug"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./sync": {
      "types": "./sync/index.d.ts",
      "import": "./sync/index.js",
      "require": "./sync/index.js"
    },
    "./multithreaded": {
      "types": "./multithreaded/index.d.ts",
      "import": "./multithreaded/index.js",
      "require": "./multithreaded/index.js"
    },
    "./multithreaded/sync": {
      "types": "./multithreaded/sync/index.d.ts",
      "import": "./multithreaded/sync/index.js",
      "require": "./multithreaded/sync/index.js"
    },
    "./nodejs": {
      "types": "./nodejs/index.d.ts",
      "require": "./nodejs/index.js"
    },
    "./nodejs/sync": {
      "types": "./nodejs/sync/index.d.ts",
      "require": "./nodejs/sync/index.js"
    }
  },
  "scripts": {
    "test": "mocha test --timeout 20000",
    "clean": "node clean.js",
    "build": "node build.mjs"
  },
  "author": "Ladybug Team",
  "license": "MIT",
  "devDependencies": {
    "chai": "^4.4.1",
    "esbuild": "^0.27.3",
    "mocha": "^10.4.0",
    "tmp": "^0.2.3"
  },
  "dependencies": {
    "threads": "^1.7.0",
    "tiny-worker": "^2.3.0",
    "uuid": "^11.0.3"
  }
}
